{
  "name": "hackathon-tectonic",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "bunx serve out",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "next typegen && tsc --noEmit",
    "check": "bun run lint && bun run typecheck",
    "db:types": "supabase gen types typescript --linked > src/lib/supabase/database.types.ts",
    "db:push": "supabase db push",
    "db:check": "node scripts/check-entries.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.130.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "motion": "^13.4.6",
    "next": "16.3.7",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@tailwindcss/postcss": "^4",
    "@types/bun": "^1.4.2",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "supabase": "^2.118.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "packageManager": "bun@1.3.9",
  "engines": {
    "node": "24.x"
  },
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
